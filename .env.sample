# ==============================================================================
# Alexia CLI - Variables de Entorno de Ejemplo
# Copia este archivo a `.env` y completa tus credenciales personales.
# ==============================================================================

# Clave institucional de entorno de Alexia (por defecto para Everest School: lkrP2d/Xkmc=)
ALEXIA_ENV_KEY=lkrP2d/Xkmc=

# Clave de centro educativo (Everest School: gILvORwYbO0=)
ALEXIA_CENTRO_EDUC=gILvORwYbO0=

# Credenciales de usuario (Alexia Familias)
ALEXIA_USER=tu_usuario
ALEXIA_PASS=tu_contraseña

# (Opcional) URL base de Alexia Web (por defecto: https://web2.alexiaedu.com)
ALEXIA_BASE_URL=https://web2.alexiaedu.com

# (Opcional) Directorio de almacenamiento de sesiones (por defecto: ~/.config/alexia)
# ALEXIA_CONFIG_DIR=~/.config/alexia
